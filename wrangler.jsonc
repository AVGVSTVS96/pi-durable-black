{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pi-durable-black",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "Session",
      },
      {
        "name": "CREDENTIALS",
        "class_name": "CredentialVault",
      },
    ],
  },
  "exports": {
    "Session": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "CredentialVault": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
